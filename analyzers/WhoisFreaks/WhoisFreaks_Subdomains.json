{
  "name": "WhoisFreaks_Subdomains",
  "version": "1.0",
  "author": "WhoisFreaks",
  "url": "https://github.com/TheHive-Project/Cortex-Analyzers",
  "license": "AGPL-V3",
  "description": "List the known subdomains of a domain with first and last seen dates. 2 credits per page.",
  "dataTypeList": [
    "domain"
  ],
  "command": "WhoisFreaks/whoisfreaks.py",
  "baseConfig": "WhoisFreaks",
  "config": {
    "service": "subdomains",
    "check_tlp": true,
    "max_tlp": 2,
    "check_pap": true,
    "max_pap": 2
  },
  "configurationItems": [
    {
      "name": "key",
      "description": "WhoisFreaks API key",
      "type": "string",
      "multi": false,
      "required": true
    },
    {
      "name": "max_pages",
      "description": "Result pages to fetch per run (each page is billed); 1 to 20",
      "type": "number",
      "multi": false,
      "required": false,
      "defaultValue": 1
    },
    {
      "name": "subdomains_status",
      "description": "Which subdomains to return: all, active or inactive",
      "type": "string",
      "multi": false,
      "required": false,
      "defaultValue": "all"
    }
  ],
  "registration_required": true,
  "subscription_required": true,
  "free_subscription": true,
  "service_homepage": "https://whoisfreaks.com",
  "service_logo": {
    "path": "assets/whoisfreaks.png",
    "caption": "logo"
  }
}
