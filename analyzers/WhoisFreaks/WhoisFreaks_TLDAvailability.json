{
  "name": "WhoisFreaks_TLDAvailability",
  "version": "1.0",
  "author": "WhoisFreaks",
  "url": "https://github.com/TheHive-Project/Cortex-Analyzers",
  "license": "AGPL-V3",
  "description": "Check whether a name is available across a list of TLDs, for brand protection. 1 credit per TLD.",
  "dataTypeList": [
    "domain",
    "other"
  ],
  "command": "WhoisFreaks/whoisfreaks.py",
  "baseConfig": "WhoisFreaks",
  "config": {
    "service": "tld_availability",
    "check_tlp": true,
    "max_tlp": 2,
    "check_pap": true,
    "max_pap": 2
  },
  "configurationItems": [
    {
      "name": "key",
      "description": "WhoisFreaks API key",
      "type": "string",
      "multi": false,
      "required": true
    },
    {
      "name": "availability_tlds",
      "description": "TLDs to check the name against, comma-separated, up to 100 (each costs 1 credit)",
      "type": "string",
      "multi": false,
      "required": false,
      "defaultValue": "com,net,org,info,biz,io,co,xyz"
    }
  ],
  "registration_required": true,
  "subscription_required": true,
  "free_subscription": true,
  "service_homepage": "https://whoisfreaks.com",
  "service_logo": {
    "path": "assets/whoisfreaks.png",
    "caption": "logo"
  }
}
