{
  "name": "WhoisFreaks_WhoisHistory",
  "version": "1.0",
  "author": "WhoisFreaks",
  "url": "https://github.com/TheHive-Project/Cortex-Analyzers",
  "license": "AGPL-V3",
  "description": "Get every historical WHOIS snapshot WhoisFreaks holds for a domain, including data redacted in today's WHOIS. 2 credits.",
  "dataTypeList": [
    "domain"
  ],
  "command": "WhoisFreaks/whoisfreaks.py",
  "baseConfig": "WhoisFreaks",
  "config": {
    "service": "whois_history",
    "check_tlp": true,
    "max_tlp": 2,
    "check_pap": true,
    "max_pap": 2
  },
  "configurationItems": [
    {
      "name": "key",
      "description": "WhoisFreaks API key",
      "type": "string",
      "multi": false,
      "required": true
    }
  ],
  "registration_required": true,
  "subscription_required": true,
  "free_subscription": true,
  "service_homepage": "https://whoisfreaks.com",
  "service_logo": {
    "path": "assets/whoisfreaks.png",
    "caption": "logo"
  }
}
