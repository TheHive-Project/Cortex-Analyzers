      "multi": false,
      "required": true
    },
    {
      "name": "key",
      "description": "Define the API key to use to connect the service",
      "type": "string",
      "multi": false,
      "required": true
    }
  ],
  "service_homepage": "https://www.microsoft.com/en-us/security/business/siem-and-xdr/microsoft-defender-threat-intelligence"
}
