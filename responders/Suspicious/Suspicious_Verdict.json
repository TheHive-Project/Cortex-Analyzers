  "description": "Classifies cases or alerts on the Suspicious platform.",
  "dataTypeList": ["thehive:case", "thehive:alert"],
  "command": "Suspicious/suspicious_verdict.py",
  "baseConfig": "Suspicious",
  "configurationItems": [
    {
      "name": "suspicious_url",
